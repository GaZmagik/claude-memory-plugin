# TDD Parity Exclusions
# Functions intentionally not unit tested

# CLI execution functions - require actual Claude CLI installation
# These are integration points that shell out to external processes
src/think/ai-invoke.ts:invokeAI
src/think/ai-invoke.ts:getClaudeCliVersion

# Stdin functions - tested indirectly via CLI command integration tests
# Require mocking process.stdin events which is integration-level testing
src/cli/parser.ts:readStdinJson
src/cli/parser.ts:readStdinRaw

